{
  "name": "scene-echoes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --no-open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "download-models": "node scripts/download-models.mjs",
    "generate-placeholders": "node scripts/generate-placeholders.mjs",
    "optimize-models": "node scripts/optimize-models.mjs",
    "optimize-video": "node scripts/optimize-video.mjs",
    "prepare-film": "node scripts/prepare-film-timeline.mjs",
    "validate-timeline": "node scripts/validate-timeline.mjs",
    "mock-conversion-server": "node scripts/mock-conversion-server.mjs",
    "conversion-server": "node scripts/conversion-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "node scripts/download-models.mjs && node scripts/generate-placeholders.mjs && node scripts/optimize-models.mjs && node scripts/validate-timeline.mjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.1",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.0",
    "@gltf-transform/functions": "^4.2.0",
    "@iwsdk/cli": "1.0.1",
    "@iwsdk/reference": "1.0.1",
    "@iwsdk/vite-plugin-dev": "1.0.1",
    "@meta-quest/metavr": "^1.8.1",
    "@types/three": "^0.181.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.181.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
